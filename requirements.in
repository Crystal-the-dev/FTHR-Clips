# Direct runtime dependencies; maintain pins in requirements-alpha.txt after
# changing this list. Release builds install from that lock for reproducibility.

# GUI
# PySide6 keeps the Python binding and the reviewed Qt runtime on the LGPLv3
# path selected by AUDIT-013. Do not add a second Qt binding.
PySide6>=6.11,<6.12

# Capture / media
# Headless build on purpose: the GUI is Qt, and full opencv-python would drag
# in a second, conflicting Qt.
opencv-python-headless>=4.13,<5
numpy>=2.4,<3

# Audio
sounddevice>=0.5,<0.6

# Input
# Windows global hotkeys. On Linux the app uses its own evdev/socket path
# (core/hotkey_manager.py) and this is only a fallback.
keyboard>=0.13.5,<0.14
